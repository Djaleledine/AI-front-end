# ==============================================================================
# ANJUCIA DERMACEUTICAL (anjucia.com) — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local (or set these variables in your hosting panel)
# ==============================================================================

# 1. GOOGLE GEMINI AI KEY (Required for DermoScan AI™ Station)
GEMINI_API_KEY=your_google_gemini_api_key_here

# 1b. DERMOSCAN AI™ ACCESS PASSWORD (Required when Coming Soon mode is active)
DERMOSCAN_ACCESS_PASSWORD=your_custom_dermoscan_password_here

# 2. MONGODB DATABASE CONNECTION (Required for Cloud Persistence)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/anjucia_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/anjucia_prod?retryWrites=true&w=majority

# 3. ADMIN COMMAND CENTER SECURITY (/admin)
ADMIN_PIN=replace_with_strong_admin_pin
ADMIN_SESSION_SECRET=replace_with_a_64_char_random_hex_secret_for_hmac_cookies

# 4. PUBLIC SITE & DOMAIN CONFIGURATION
NEXT_PUBLIC_SITE_URL=https://anjucia.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=213550123456

# 5. ALGERIAN LOGISTICS CARRIERS API PLACEHOLDERS (Optional)
YALIDINE_API_ID=your_yalidine_api_id_here
YALIDINE_API_TOKEN=your_yalidine_api_token_here
ZR_EXPRESS_API_KEY=your_zrexpress_api_key_here
ZR_EXPRESS_API_TOKEN=your_zrexpress_api_token_here
MAYSTRO_API_TOKEN=your_maystro_delivery_api_token_here

# 6. NOTIFICATIONS & ALERTS PLACEHOLDERS (Optional)
ORDER_WEBHOOK_URL=https://your-webhook-endpoint.example.com/anjucia-orders
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@anjucia.com
SMTP_PASS=your_email_password_here

